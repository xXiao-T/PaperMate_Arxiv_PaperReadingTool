# ============================================
#  PaperMate AI 对话 - 环境变量配置模板
# ============================================
# 使用方法：
#   1. 复制本文件为 .env
#      cp .env.example .env
#   2. 填写下方各项配置值
#   3. 重启开发服务器（npm start）
#
# ⚠️ .env 文件不会被 Git 跟踪，请勿提交真实 Key
#
# 💡 以下默认值以 DeepSeek 开放平台为例：
#    注册 → https://platform.deepseek.com
#    获取 Key → 控制台 → API Keys → 创建

# ---- 服务商 & 端点 ----
# DeepSeek 开放平台（V4 最新模型）
REACT_APP_AI_PROVIDER=deepseek
REACT_APP_AI_BASE_URL=https://api.deepseek.com
# 前往 https://platform.deepseek.com/api_keys 创建并复制
REACT_APP_AI_API_KEY=sk-your-deepseek-api-key-here

# ---- 模型参数 ----
# deepseek-v4-flash = V4 快速推理（推荐日常使用）
# deepseek-v4-pro   = V4 旗舰专业版（深度推理与分析，推荐论文场景）
# deepseek-chat / deepseek-reasoner 将于 2026/07/24 弃用，请迁移至 V4
REACT_APP_AI_MODEL=deepseek-v4-pro
REACT_APP_AI_TEMPERATURE=0.5
REACT_APP_AI_MAX_TOKENS=4096
REACT_APP_AI_TOP_P=0.95

# ---- 请求行为 ----
REACT_APP_AI_TIMEOUT=60000
REACT_APP_AI_MAX_RETRIES=2

# ---- 上下文窗口 ----
# DeepSeek-V4 支持 128K 上下文，这里限制携带最近 N 条历史
REACT_APP_AI_MAX_CONTEXT=20
REACT_APP_AI_PAPER_ABSTRACT_MAX_LEN=2000

# ---- 流式输出 ----
# DeepSeek API 原生支持 SSE 流式 (stream: true)
REACT_APP_AI_STREAM_ENABLED=true
REACT_APP_AI_STREAM_CHUNK_DELAY=30

# ---- 系统提示词（可选，留空使用默认论文助手人设） ----
# REACT_APP_AI_SYSTEM_PROMPT=