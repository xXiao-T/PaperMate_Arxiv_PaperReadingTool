# ============================================
#  PaperMate Frontend — .gitignore
# ============================================

# ---- 依赖 ----
node_modules/
/.pnp
.pnp.js

# ---- 构建产物 ----
/build

# ---- 环境变量 ----
# .env 包含真实 API Key，严禁提交到版本控制
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 调试日志 ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*